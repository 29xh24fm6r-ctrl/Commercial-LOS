        "x-ms-visibility": "important",
        "parameters": [{ "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/Request" } }],
        "responses": { "200": { "description": "Governed result", "schema": { "$ref": "#/definitions/Response" } }, "400": { "description": "Invalid request" }, "403": { "description": "Not authorized" }, "409": { "description": "Duplicate or ambiguous effective record" } }
      }
    }
  },
  "definitions": {
    "Request": {
      "type": "object",
