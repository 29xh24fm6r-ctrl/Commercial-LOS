      "properties": {
        "CorrelationId": { "type": "string", "format": "uuid", "x-ms-visibility": "internal" },
        "Tool": { "type": "string", "enum": ["research_party", "build_credit_evidence_packet", "explain_governance_route", "relationship_intelligence", "portfolio_monitoring", "policy_intelligence"] },
